# ppm configuration example
# 이 파일을 ~/.config/ppm/config.yaml 로 복사하여 사용하세요.

# 레지스트리 API 주소 (GitHub 사용 시 기본값 사용)
registry_url: https://api.github.com

# 프라이빗 레포지토리 접근을 위한 인증 토큰 (필수)
auth_token: "your_personal_access_token_here"

# 패키지가 설치될 절대 경로
# 입력하지 않으면 기본적으로 ~/.local/bin 경로에 설치됩니다.
install_path: "/home/user/.local/bin"
